# Postgres connection string. Local dev default matches the `createdb vendor_directory`
# instructions in the README. Swap to a Neon/Railway URL for hosted deploys — no code change needed.
# NOTE: put this one in .env (not .env.local) — the Prisma CLI only auto-loads .env.
DATABASE_URL="postgresql://localhost:5432/vendor_directory"

# Admin auth (see src/lib/auth.ts). Pick any long random strings for local dev.
ADMIN_PASSWORD="changeme"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# Vercel Blob token for portfolio image uploads. Without it, the admin vendor form
# falls back to a plain "paste an image URL" field.
BLOB_READ_WRITE_TOKEN=""

# Resend API key for inquiry notification emails. Without it, submissions still save
# to the database — the would-be email is just logged to the console instead.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
ADMIN_NOTIFICATION_EMAIL="you@example.com"
